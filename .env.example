# Copy to .env and adjust. All variables are optional except SECRET_KEY in production.
KUBEASSIST_SECRET_KEY=change-me-to-a-long-random-string
# KUBEASSIST_ACCESS_CODE=          # if set, users must enter it in the UI
KUBEASSIST_KUBECONFIG=~/.kube/config
# KUBEASSIST_KUBECTL_BIN=/usr/local/bin/kubectl
KUBEASSIST_LLM_URL=http://localhost:11434
KUBEASSIST_LLM_MODEL=mistral:instruct
# KUBEASSIST_VECTOR_SEARCH=1
# KUBEASSIST_RATE_LIMIT_PER_MINUTE=30
